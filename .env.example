# Copy this file to .env and edit it. Never commit .env.
# Comments must be on their own line (a comment after an empty value becomes the value).

# "production" turns on safety checks (API_KEYS required, /docs hidden)
ENV=development
LOG_LEVEL=INFO

# --- security ---
# Comma separated list of allowed keys, e.g. API_KEYS=key1,key2. REQUIRED when ENV=production.
API_KEYS=
# Sites allowed to call the API from a browser, e.g. https://his.namazi.example. Empty = none.
CORS_ORIGINS=
# Requests per minute per API key / IP, counted per worker. 0 = off.
RATE_LIMIT_PER_MINUTE=30
# false = never store question or answer text, only a hash of the question.
LOG_QUESTIONS=true

# --- LLM: any OpenAI-compatible server (OpenAI, vLLM, Ollama, ...) ---
# In the hospital use a local Ollama server, so questions never leave the network:
#   LLM_BASE_URL=http://ollama:11434/v1   (with docker compose)  or  http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b-instruct
# Empty LLM_BASE_URL = OpenAI. A local model on a small GPU needs a longer timeout.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=700
LLM_TIMEOUT_S=60
LLM_RETRIES=3

# --- embeddings ---
# e5 models need the two prefixes below. Models such as bge-m3 need none: leave them empty.
EMBEDDING_MODEL=BAAI/bge-m3
QUERY_PREFIX=
PASSAGE_PREFIX=

# --- chunking, in words. After changing these run: python -m scripts.ingest ---
CHUNK_SIZE=250
CHUNK_OVERLAP=50

# --- retrieval. Restart is enough, no re-ingest. Find good values with: python -m scripts.tune ---
TOP_K=5
OVERSAMPLE=3
RRF_K=60
# A second model re-orders the best chunks (about 0.4 s per question). Empty = off.
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_POOL=20
WEIGHT_DENSE=1
WEIGHT_BM25=1
BM25_K1=1.2
BM25_B=0.75
# 0 = off. scripts/tune.py suggests a value.
MIN_DENSE_SCORE=0
MAX_CONTEXT_CHARS=12000

# --- paths ---
BOOKS_DIR=data/books
INDEX_DIR=data/index
DB_PATH=data/app.db

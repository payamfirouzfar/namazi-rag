{
  "uid": "namazi",
  "title": "Namazi RAG",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "price_in",
        "label": "price_in",
        "type": "textbox",
        "query": "1",
        "current": {
          "text": "1",
          "value": "1"
        },
        "options": [
          {
            "selected": true,
            "text": "1",
            "value": "1"
          }
        ]
      },
      {
        "name": "price_out",
        "label": "price_out",
        "type": "textbox",
        "query": "3",
        "current": {
          "text": "3",
          "value": "3"
        },
        "options": [
          {
            "selected": true,
            "text": "3",
            "value": "3"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Questions per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (instance) (rate(namazi_questions_total[1m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Answer time (median and 95%)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le, instance) (rate(namazi_answer_seconds_bucket[1m])))",
          "legendFormat": "median {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(namazi_answer_seconds_bucket[1m])))",
          "legendFormat": "95% {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (instance) (increase(namazi_errors_total[1m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Share of questions not found in the books",
      "description": "A sudden jump can mean a missing book or a broken search.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (instance) (rate(namazi_not_found_total[5m])) / sum by (instance) (rate(namazi_questions_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(namazi_prompt_tokens_total[1m])) * 60",
          "legendFormat": "prompt"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(namazi_completion_tokens_total[1m])) * 60",
          "legendFormat": "answer"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Questions being worked on at the same time",
      "description": "Average number of questions inside the app at one moment. If it stays high, the LLM is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (instance) (rate(namazi_answer_seconds_sum[1m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cost of the last hour if this was a paid API (USD)",
      "description": "The local model costs nothing per token. This shows what the same tokens would cost on a paid service. Set the two prices above.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "(increase(namazi_prompt_tokens_total[1h]) * $price_in + increase(namazi_completion_tokens_total[1h]) * $price_out) / 1000000",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "tags": [
    "namazi"
  ],
  "description": "Example prices are USD per million tokens. Change them to your own."
}